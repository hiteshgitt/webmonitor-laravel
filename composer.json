{
    "name": "ruyalab/webmonitor-laravel",
    "description": "Connect a Laravel app to Web Monitor (webmonitor.ruyalab.com): uptime, performance, SEO and security checks.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "monitoring", "uptime", "health-check", "webmonitor"],
    "homepage": "https://webmonitor.ruyalab.com/integrations#laravel",
    "authors": [{ "name": "Ruyalab" }],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": { "Ruyalab\\WebMonitor\\": "src/" }
    },
    "extra": {
        "laravel": {
            "providers": ["Ruyalab\\WebMonitor\\Laravel\\WebMonitorServiceProvider"]
        }
    },
    "minimum-stability": "stable"
}
